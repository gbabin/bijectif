#!/bin/bash
set -eo pipefail
IFS=$'\n\t'

version=$(git describe --tags HEAD | sed 's/^v//;s/-/+/g;s/_/./')

rm -rf build/makepkg-head
mkdir -p build/makepkg-head

cp PKGBUILD build/makepkg-head/
git archive --format=tar -o "build/makepkg-head/bijectif-$version.tar" --prefix="bijectif-$version/" HEAD
git submodule foreach --recursive 'git archive --format=tar -o "$toplevel/build/makepkg-head/bijectif-sm-$sha1.tar" --prefix="bijectif-'"$version"'/$sm_path/" HEAD \
                                   && tar --concatenate --file="$toplevel/build/makepkg-head/bijectif-'"$version"'.tar" "$toplevel/build/makepkg-head/bijectif-sm-$sha1.tar" \
                                   && rm "$toplevel/build/makepkg-head/bijectif-sm-$sha1.tar"'
gzip -c9 "build/makepkg-head/bijectif-$version.tar" > "build/makepkg-head/bijectif-$version.tar.gz"

cd build/makepkg-head/

sed -i "s/^pkgver=.*/pkgver=$version/" PKGBUILD
sed -i "s/^pkgrel=.*/pkgrel=1/" PKGBUILD

makepkg "$@"
